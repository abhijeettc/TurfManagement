# Tests run against their own database and truncate it freely. Committed on
# purpose: `npm test` must never be one stray truncate away from wiping the
# venue you were looking at.
DATABASE_URL=postgres://turfsync:turfsync@localhost:5434/turfsync_test

# Same Redis the dev server uses — the blocking tests use unique venue/job ids
# and clean up after themselves, so sharing it with dev is safe.
REDIS_URL=redis://localhost:6380
SESSION_ENCRYPTION_KEY=test-only-key-not-for-anything-real
