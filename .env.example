# Postgres. Port 5434 on the host so it fights neither a local 5432 nor another
# project on 5433.
DATABASE_URL=postgres://turfsync:turfsync@localhost:5434/turfsync

# API
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Number of reverse-proxy hops in front of the API (1 behind a single load
# balancer). Needed in production so rate limits see the real client address.
# TRUST_PROXY=1

# Development only: shows an "Admin" one-click sign-in on the login screen for
# this account. Ignored when NODE_ENV=production. Leave unset anywhere the
# server is reachable by people you do not trust.
# DEV_QUICK_LOGIN_EMAIL=owner@turfsync.local

# Session cookies are marked Secure when NODE_ENV=production. Leave it unset in
# development or the cookie will not survive plain HTTP.

# There is no shared DEVICE_TOKEN or INBOUND_EMAIL_TOKEN any more. Device tokens
# are issued per venue when a tablet is paired (POST /api/devices) and stored
# hashed; each venue also gets its own inbound-email secret at signup. A shared
# secret could not say which venue a notification belonged to, and let any
# paired device post into any venue's board.
#
# `npm run seed` prints a device token and an inbound secret for the demo venue.
# Export the device token for tools/simulate.js:
#   export DEVICE_TOKEN=<token>

# Claude Haiku fallback parser. Unset in dev — parsing then fails loudly to the
# parse-failure log instead of silently guessing, which is what we want locally.
# ANTHROPIC_API_KEY=
PARSER_FALLBACK_MODEL=claude-haiku-4-5

# Phase 3 write-back — the block-job worker (apps/api/src/worker-entry.js),
# a separate process from the API. Inert everywhere: every venue's
# auto_block_enabled defaults false, so nothing calls Redis or an adapter
# until someone deliberately turns write-back on for a venue that has earned it.

# Redis. Port 6380, not the default 6379 — this machine already runs another
# project's Redis on 6379.
REDIS_URL=redis://localhost:6380

# Encrypts platform_accounts.session_blob (AES-256-GCM). In production this
# must come from a real secrets manager, not sit here in a flat env var next
# to the sessions it protects. The dev value below is fine for a laptop only.
SESSION_ENCRYPTION_KEY=dev-only-change-me-before-any-real-session-is-stored

# Run the worker against MockAdapter instead of a real platform:
#   npm run worker:mock

# WhatsApp (apps/api/src/notify.js). Unset or 'console' logs every alert and
# block-task message instead of sending it — the safe default for dev/tests.
# WHATSAPP_PROVIDER=gupshup

# Only needed when WHATSAPP_PROVIDER=gupshup. GUPSHUP_TEMPLATE_IDS maps each
# key in notify.js's TEMPLATES to the id of the matching Meta-approved
# template in the Gupshup dashboard — all 9 must exist and be approved before
# turning this provider on, or sends for unmapped templates will throw.
# GUPSHUP_API_KEY=
# GUPSHUP_SOURCE_NUMBER=
# GUPSHUP_APP_NAME=
# GUPSHUP_TEMPLATE_IDS={"booking_alert":"","conflict_alert":"","parse_failure":"","device_silent":"","block_failed":"","block_task":"","block_task_overdue":"","unblock_task":"","unblock_task_overdue":""}
