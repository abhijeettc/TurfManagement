<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TurfSync device setup"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Two steps, in this order. The code in step 2 expires after ten minutes, so do step 1 first."
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!--
          Notification access comes first on purpose. It is the slow step — on
          MIUI it means finding this app in a long alphabetical list, and then
          the Autostart screen below as well — while the pairing code is the
          perishable one. Asking for the code first started a ten-minute clock
          before the slow part had even begun.
        -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Step 1 — let TurfSync read booking notifications"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bookings arrive as WhatsApp messages. Without this, nothing is ever captured."
            android:textSize="13sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/grantAccessButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant notification access" />

        <TextView
            android:id="@+id/accessStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/miuiFixLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="On Xiaomi, Redmi and POCO phones one more switch is needed, or MIUI silently stops TurfSync from running and no booking is ever captured."
            android:textSize="13sp"
            android:paddingTop="10dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/miuiFixButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allow autostart (MIUI)"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="26dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Step 2 — connect this tablet to your venue"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sign in with your TurfSync account, or create one if this is your first time. The tablet connects itself."
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/signInButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sign in or create an account" />

        <!--
          The code path is kept, but second: it is how a venue adds a tablet
          without typing the owner's password onto it, which matters for a shared
          counter device. It is the wrong default for someone who has just
          installed the app and has no account for a code to come from.
        -->
        <TextView
            android:id="@+id/codeToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▸ I was given a pairing code"
            android:textSize="13sp"
            android:paddingTop="20dp"
            android:paddingBottom="4dp" />

        <EditText
            android:id="@+id/codeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:digits="0123456789 "
            android:maxLength="11"
            android:textSize="24sp"
            android:hint="8 digits"
            android:layout_marginBottom="14dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pair with code"
            android:visibility="gone" />

        <!--
          The address is correct out of the box and a venue owner has no reason
          to think about it; it stays reachable for a self-hosted server or a
          staging build, just not in the way of the two steps that matter.
        -->
        <TextView
            android:id="@+id/advancedToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▸ Advanced settings"
            android:textSize="13sp"
            android:paddingTop="28dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/apiUrlLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Server address"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/apiUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:hint="https://your-turfsync-server"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
