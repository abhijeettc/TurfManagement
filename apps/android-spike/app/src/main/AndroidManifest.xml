<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Android 11+ hides other apps' installed state by default (package
      visibility). Without these, getLaunchIntentForPackage() below always
      returns null — even when the app is installed — so "Open Playo" would
      silently fall through to the Play Store every time.

      Partner/owner-app package names, not the consumer apps — those are what
      actually have a "block this slot" screen. Captured in
      06-Multi-Platform-Channel-Sync.md §14; verify against the Play Store
      listing before relying on this, since a platform can rename its package.
      District's partner-app package was never captured, so it is not listed
      here — "Open District" falls back to instructions only until it is.
    -->
    <queries>
        <package android:name="com.techmash.playobooking" />
        <package android:name="com.hudle.partner.app" />
        <package android:name="com.khelomore.pnp.vendor" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DeviceSetupActivity"
            android:exported="false" />

        <!-- TurfPro's owner panel inside TurfSync: where the owner signs in so blocking can run by itself. -->
        <activity
            android:name=".TurfProLoginActivity"
            android:exported="false" />

        <!--
          BIND_NOTIFICATION_LISTENER_SERVICE is a signature-level permission
          held by the system: declaring it here is what lets Android bind to
          this service once the user grants access in Settings. There is no
          runtime-permission dialog for this — it can only be granted from the
          notification-access screen, which is why DeviceSetupActivity links
          straight to it.
        -->
        <service
            android:name=".NotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
