{
  "name": "@turfsync/slot-sync-aws",
  "private": true,
  "version": "0.1.0",
  "description": "AWS-serverless multi-platform slot sync (Lambda + DynamoDB + SQS + S3 + Playwright). Runs alongside, not instead of, apps/api's assisted-blocking flow.",
  "type": "module",
  "dependencies": {
    "@turfsync/core": "*",
    "@turfsync/parsers": "*",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-kms": "^3.700.0",
    "imapflow": "^1.0.171",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "aws-cdk": "^2.170.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.24.0"
  },
  "scripts": {
    "synth": "cdk synth --app \"node infra/bin/app.mjs\" -o infra/cdk.out",
    "test": "node --test test/*.test.mjs",
    "local:up": "docker compose up -d localstack && node tools/bootstrap-local.mjs",
    "local:down": "docker compose down",
    "local:test": "node tools/local-run.mjs",
    "local:server": "node tools/local-server.mjs"
  }
}
